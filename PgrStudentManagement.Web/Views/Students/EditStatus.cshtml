@model PgrStudentManagement.Web.Models.Student

@{
    ViewData["Title"] = "Update Student Status";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h2 mb-1">Update Student Status</h1>
            <p class="text-muted mb-0">Change academic status for @Model.FullName (@Model.StudentNumber)</p>
        </div>
        <div>
            <a asp-action="EnrolmentDetails" asp-route-studentNumber="@Model.StudentNumber" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <div asp-validation-summary="All" class="text-danger mb-0"></div>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="EditStatus" method="post">
                <input type="hidden" name="studentNumber" value="@Model.StudentNumber" />

                <div class="mb-3">
                    <label class="form-label text-muted">Student</label>
                    <input type="text" class="form-control" value="@Model.FullName (@Model.StudentNumber)" readonly disabled />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">Current Status</label>
                    <div>
                        <span class="badge @(Model.Status switch {
                            PgrStudentManagement.Web.Models.Status.Researching => "bg-primary",
                            PgrStudentManagement.Web.Models.Status.WritingUp => "bg-info text-dark",
                            PgrStudentManagement.Web.Models.Status.Submitted => "bg-success",
                            PgrStudentManagement.Web.Models.Status.Corrections => "bg-warning text-dark",
                            PgrStudentManagement.Web.Models.Status.Completed => "bg-dark",
                            PgrStudentManagement.Web.Models.Status.Suspended => "bg-secondary",
                            PgrStudentManagement.Web.Models.Status.Withdrawn => "bg-danger",
                            _ => "bg-light text-dark"
                        }) fs-6">
                            @Model.Status
                        </span>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="status" class="form-label fw-bold">Select New Status</label>
                    <select id="status" name="status" class="form-select" asp-items="Html.GetEnumSelectList<PgrStudentManagement.Web.Models.Status>()" asp-for="Status">
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Status</button>
                    <a asp-action="EnrolmentDetails" asp-route-studentNumber="@Model.StudentNumber" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>