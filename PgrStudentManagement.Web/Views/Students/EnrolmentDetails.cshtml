@model PgrStudentManagement.Web.Models.Student

@{
    ViewData["Title"] = "Enrolment Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h2 mb-1">Enrolment Details</h1>
            <p class="text-muted mb-0">Academic enrolment record for @Model.FullName (@Model.StudentNumber)</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back to Students</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 fw-bold text-primary">Student Information</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Student Number</dt>
                <dd class="col-sm-8 fw-semibold">@Model.StudentNumber</dd>

                <dt class="col-sm-4 text-muted">Student Name</dt>
                <dd class="col-sm-8 fw-semibold">@Model.FullName</dd>

                <dt class="col-sm-4 text-muted">Research Programme</dt>
                <dd class="col-sm-8">@(Model.Course ?? "Not specified")</dd>

                <dt class="col-sm-4 text-muted">Mode of Study</dt>
                <dd class="col-sm-8">@(Model.ModeOfStudy ?? "Not specified")</dd>

                <dt class="col-sm-4 text-muted">Start Date</dt>
                <dd class="col-sm-8">
                    @(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy") : "Not specified")
                </dd>

                <dt class="col-sm-4 text-muted">Current Student Status</dt>
                <dd class="col-sm-8">
                    <span class="badge @(Model.Status switch {
                        PgrStudentManagement.Web.Models.Status.Researching => "bg-primary",
                        PgrStudentManagement.Web.Models.Status.WritingUp => "bg-info text-dark",
                        PgrStudentManagement.Web.Models.Status.Submitted => "bg-success",
                        PgrStudentManagement.Web.Models.Status.Corrections => "bg-warning text-dark",
                        PgrStudentManagement.Web.Models.Status.Completed => "bg-dark",
                        PgrStudentManagement.Web.Models.Status.Suspended => "bg-secondary",
                        PgrStudentManagement.Web.Models.Status.Withdrawn => "bg-danger",
                        _ => "bg-light text-dark"
                    })">
                        @Model.Status
                    </span>
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-light d-flex gap-2">
            <a asp-action="EditStatus" asp-route-studentNumber="@Model.StudentNumber" class="btn btn-primary btn-sm">
                Edit Status
            </a>
            <a asp-action="ThesisDetails" asp-route-studentNumber="@Model.StudentNumber" class="btn btn-outline-secondary btn-sm">
                View Thesis Details
            </a>
        </div>
    </div>
</div>