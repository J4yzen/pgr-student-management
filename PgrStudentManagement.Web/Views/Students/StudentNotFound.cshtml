@{
    ViewData["Title"] = "Student Not Found";
}

<div class="container mt-4">
    <div class="alert alert-danger shadow-sm border-danger" role="alert">
        <h4 class="alert-heading fw-bold mb-2">Student not found</h4>
        <p class="mb-0">
            No student matches the supplied student number
            @if (!string.IsNullOrWhiteSpace(ViewBag.StudentNumber as string))
            {
                <strong>(@ViewBag.StudentNumber)</strong>
            }
            .
        </p>
    </div>
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Return to Students</a>
    </div>
</div>
