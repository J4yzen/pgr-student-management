@model PgrStudentManagement.Web.Models.Student

@{
    ViewData["Title"] = "Update Expected Thesis Submission Date";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h2 mb-1">Update Expected Submission Date</h1>
            <p class="text-muted mb-0">Manage thesis milestone date for @Model.FullName (@Model.StudentNumber)</p>
        </div>
        <div>
            <a asp-action="ThesisDetails" asp-route-studentNumber="@Model.StudentNumber" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <div asp-validation-summary="All" class="text-danger mb-0"></div>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="EditExpectedSubmissionDate" method="post">
                <input type="hidden" name="studentNumber" value="@Model.StudentNumber" />

                <div class="mb-3">
                    <label class="form-label text-muted">Student</label>
                    <input type="text" class="form-control" value="@Model.FullName (@Model.StudentNumber)" readonly disabled />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">Thesis Title</label>
                    <input type="text" class="form-control" value="@(Model.ThesisTitle ?? "Not recorded")" readonly disabled />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">Current Expected Submission Date</label>
                    <input type="text" class="form-control"
                           value="@(Model.ExpectedSubmissionDate.HasValue ? Model.ExpectedSubmissionDate.Value.ToString("dd/MM/yyyy") : "Not recorded")"
                           readonly disabled />
                </div>

                <div class="mb-4">
                    <label for="expectedSubmissionDate" class="form-label fw-bold">New Expected Submission Date</label>
                    <input type="date"
                           id="expectedSubmissionDate"
                           name="expectedSubmissionDate"
                           class="form-control"
                           value="@(Model.ExpectedSubmissionDate.HasValue ? Model.ExpectedSubmissionDate.Value.ToString("yyyy-MM-dd") : string.Empty)"
                           required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">Save Expected Date</button>
                    <a asp-action="ThesisDetails" asp-route-studentNumber="@Model.StudentNumber" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>